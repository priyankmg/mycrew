# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# These two variable names match exactly what the Neon Postgres integration
# for Vercel injects into your project, so no remapping is needed on deploy.
#
#   DATABASE_URL          -> pooled connection (PgBouncer). Used at runtime.
#   DATABASE_URL_UNPOOLED -> direct connection.  Used by Prisma Migrate,
#                            which cannot run DDL through a transaction pooler.
#
# For local development, create a dedicated Neon branch (e.g. "dev") so you
# never run migrations against production data.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "mock"      -> deterministic rule-based provider. No network, no key needed.
#                Used by tests and for running the stack offline.
# "anthropic" -> real Claude API. This is the Phase 1 target.
MYCREW_LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
# Not required while using the built-in web chat simulator.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
